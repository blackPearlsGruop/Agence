<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layoutDirection="rtl"
        android:background="@color/agence_bg">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/_40sdp"
            android:paddingBottom="@dimen/_12sdp"
            android:paddingHorizontal="@dimen/_16sdp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:padding="@dimen/_8sdp"
                android:background="@drawable/bg_opp_circle_light"
                android:src="@drawable/ic_back"
                android:tint="@color/agence_black"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/ui_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ui_available_opportunities"
                android:fontFamily="@font/somar_bold"
                android:textSize="@dimen/_16ssp"
                android:textColor="@color/agence_black"
                android:gravity="center" />

            <View
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_an_opportunity"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingBottom="@dimen/_16sdp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_an_opportunity" />

    </LinearLayout>
</layout>