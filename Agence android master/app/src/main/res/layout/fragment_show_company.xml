<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/agence_bg">

        <!-- Own light header (matches Home/Account/Orders/Messages/Support) -->
        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_14sdp">

            <FrameLayout
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:background="@drawable/bg_agence_chip_white">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_arrow_back"/>

            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:gravity="end"
                android:text="@string/company_details"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_16ssp"/>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingBottom="@dimen/_20sdp">

                <!-- ═══ Profile card: gradient header + avatar + tag ═══ -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    app:cardCornerRadius="@dimen/_20sdp"
                    app:cardElevation="@dimen/_4sdp">

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/agence_card">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_78sdp"
                            android:background="@drawable/bg_gradient_header_blue">

                            <TextView
                                android:id="@+id/tv_tag"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|end"
                                android:layout_margin="@dimen/_10sdp"
                                android:paddingHorizontal="@dimen/_8sdp"
                                android:paddingVertical="@dimen/_3sdp"
                                android:fontFamily="@font/somar_bold"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_8ssp"
                                tools:text="الأعلى تقييماً"/>

                        </FrameLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="-28dp"
                            android:paddingHorizontal="@dimen/_15sdp"
                            android:paddingBottom="@dimen/_15sdp">

                            <androidx.cardview.widget.CardView
                                android:layout_width="@dimen/_56sdp"
                                android:layout_height="@dimen/_56sdp"
                                android:layout_marginBottom="@dimen/_8sdp"
                                app:cardCornerRadius="@dimen/_14sdp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:id="@+id/iv_logo_company"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="centerCrop"
                                    android:src="@drawable/backround_image"/>

                            </androidx.cardview.widget.CardView>

                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:layout_height="wrap_content">

                                    <TextView
                                        android:id="@+id/tv_name_company"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/somar_bold"
                                        android:textColor="@color/agence_black"
                                        android:textSize="@dimen/_15ssp"
                                        tools:text="فهد العتيبي"/>

                                    <LinearLayout
                                        android:id="@+id/layout_badges"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_6sdp"/>

                                    <TextView
                                        android:id="@+id/tv_specialty"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="@dimen/_8sdp"
                                        android:paddingHorizontal="@dimen/_9sdp"
                                        android:paddingVertical="@dimen/_3sdp"
                                        android:background="@drawable/bg_status_blue"
                                        android:fontFamily="@font/somar_semi_bold"
                                        android:textColor="@color/agence_blue"
                                        android:textSize="@dimen/_9ssp"
                                        tools:text="استراتيجية العلامة التجارية والسوشيال"/>

                                </LinearLayout>

                                <LinearLayout
                                    android:orientation="vertical"
                                    android:gravity="end"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">

                                    <RatingBar
                                        android:id="@+id/rating_bar"
                                        style="?android:attr/ratingBarStyleSmall"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="-6dp"
                                        android:focusable="false"
                                        android:isIndicator="true"
                                        android:numStars="5"
                                        android:progressTint="#FEB702"
                                        android:rating="4.5"
                                        android:scaleX="0.75"
                                        android:scaleY="0.75"
                                        android:stepSize="0.1"/>

                                    <TextView
                                        android:id="@+id/tv_count_rat"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/somar_regular"
                                        android:textColor="@color/agence_muted"
                                        android:textSize="@dimen/_9ssp"
                                        tools:text="138 تقييم"/>

                                </LinearLayout>

                            </LinearLayout>

                            <TextView
                                android:id="@+id/tv_address_company"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:drawableStart="@drawable/icon_location"
                                android:drawablePadding="@dimen/_4sdp"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/agence_muted"
                                android:textSize="@dimen/_10ssp"
                                tools:text="الرياض، المملكة العربية السعودية"/>

                            <TextView
                                android:id="@+id/tv_agency_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:fontFamily="@font/somar_semi_bold"
                                android:textColor="@color/agence_orange"
                                android:textSize="@dimen/_10ssp"
                                tools:text="وكالة الرواد للتسويق"/>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- ═══ Brief ═══ -->
                <LinearLayout
                    android:id="@+id/layout_brief_card"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/brief"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_muted"
                        android:textSize="@dimen/_10ssp"
                        android:letterSpacing="0.05"/>

                    <TextView
                        android:id="@+id/tv_brief"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_black"
                        android:textSize="@dimen/_12ssp"
                        android:lineSpacingExtra="3dp"
                        tools:text="المدير الإبداعي السابق في وكالة Leo Burnett الرياض."/>

                </LinearLayout>

                <!-- ═══ Past work chips ═══ -->
                <LinearLayout
                    android:id="@+id/layout_past_work_card"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/past_work"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_muted"
                        android:textSize="@dimen/_10ssp"
                        android:letterSpacing="0.05"/>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layout_past_work"
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- ═══ Services ═══ -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/services"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_muted"
                        android:textSize="@dimen/_10ssp"
                        android:letterSpacing="0.05"/>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_company_service"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>
