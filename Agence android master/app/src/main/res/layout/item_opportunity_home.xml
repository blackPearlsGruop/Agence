<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="@dimen/_195sdp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/_10sdp"
    android:layout_marginTop="@dimen/_4sdp"
    android:layout_marginBottom="@dimen/_4sdp"
    android:padding="@dimen/_11sdp"
    android:background="@drawable/shape_text">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <FrameLayout
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:background="@drawable/bg_opp_logo_box">

            <ImageView
                android:layout_width="@dimen/_16sdp"
                android:layout_height="@dimen/_16sdp"
                android:layout_gravity="center"
                android:src="@drawable/ic_opp_company" />

        </FrameLayout>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp">

            <TextView
                android:id="@+id/tv_opportunity_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:ellipsize="end"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/text"
                android:textSize="@dimen/_11ssp"
                tools:text="إعداد حملة إعلانات جوجل"/>

            <TextView
                android:id="@+id/tv_opportunity_company"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_1sdp"
                android:fontFamily="@font/somar_regular"
                android:textColor="@color/grey_bold"
                android:textSize="@dimen/_9ssp"
                tools:text="صيدلية المدينة"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_opportunity_tags"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_9sdp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_opportunity_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/primary"
                android:textSize="@dimen/_13ssp"
                tools:text="150 ريال"/>

            <TextView
                android:id="@+id/tv_opportunity_deadline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:drawableStart="@drawable/icon_calendar"
                android:drawablePadding="@dimen/_3sdp"
                android:fontFamily="@font/somar_regular"
                android:textColor="@color/grey_bold"
                android:textSize="@dimen/_8ssp"
                tools:text="15 أغسطس 2026"/>

        </LinearLayout>

        <TextView
            android:id="@+id/btn_opportunity_apply"
            android:layout_width="@dimen/_34sdp"
            android:layout_height="@dimen/_34sdp"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/white"
            android:textSize="@dimen/_18ssp"
            android:textStyle="bold"
            android:background="@drawable/bg_smart_matching_btn"
            android:backgroundTint="@color/primary"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>