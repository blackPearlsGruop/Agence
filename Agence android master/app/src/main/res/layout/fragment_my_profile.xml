<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF4F4"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        tools:context=".ui.fragment.auth.MyProfileFragment">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_32sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_profile_back_btn"
                android:clickable="true"
                android:contentDescription="@string/profile_back"
                android:focusable="true"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/somar_bold"
                android:text="@string/profile_screen_title"
                android:textColor="@color/text"
                android:textSize="@dimen/_14ssp" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingBottom="@dimen/_14sdp">

                <!-- Identity card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/_20sdp"
                    android:paddingBottom="@dimen/_16sdp">

                    <FrameLayout
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_80sdp">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_avatar_ring"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/tv_avatar_initial"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_profile_avatar"
                                android:fontFamily="@font/somar_bold"
                                android:gravity="center"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_28ssp"
                                tools:text="ن" />

                            <de.hdodenhof.circleimageview.CircleImageView
                                android:id="@+id/iv_user_login"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone"
                                app:civ_border_color="@color/white"
                                app:civ_border_width="3dp" />
                        </FrameLayout>

                        <FrameLayout
                            android:id="@+id/btn_change_photo"
                            android:layout_width="@dimen/_28sdp"
                            android:layout_height="@dimen/_28sdp"
                            android:layout_gravity="bottom|start"
                            android:background="@drawable/bg_profile_camera"
                            android:clickable="true"
                            android:contentDescription="@string/profile_change_photo"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile_camera" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_nameUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_14ssp"
                        tools:text="نورة العتيبي" />

                    <TextView
                        android:id="@+id/tv_username_display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="#5F5F5F"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_10ssp"
                        tools:text="\@noura_design" />

                    <TextView
                        android:id="@+id/tv_account_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_profile_chip"
                        android:fontFamily="@font/somar_bold"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingTop="@dimen/_3sdp"
                        android:paddingEnd="@dimen/_12sdp"
                        android:paddingBottom="@dimen/_3sdp"
                        android:text="@string/profile_account_client"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_9ssp" />
                </LinearLayout>

                <!-- Personal information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_personal"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_full_name"
                        android:text="@string/profile_full_name"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_user" />

                        <EditText
                            android:id="@+id/tv_full_name"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_regular"
                            android:hint="@string/profile_full_name"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_username"
                        android:text="@string/profile_username"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:text="\@"
                            android:textColor="#F58220"
                            android:textSize="@dimen/_13ssp" />

                        <EditText
                            android:id="@+id/et_username"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:digits="abcdefghijklmnopqrstuvwxyz0123456789_."
                            android:fontFamily="@font/somar_regular"
                            android:gravity="center_vertical|start"
                            android:hint="username"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="30"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textDirection="ltr"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_birth_date"
                        android:text="@string/profile_birth_date"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:id="@+id/layout_birth_date"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_calendar" />

                        <TextView
                            android:id="@+id/et_birth_date"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_regular"
                            android:hint="@string/profile_choose_birth_date"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_down" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Contact information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_contact"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_email"
                        android:text="@string/profile_email"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <EditText
                            android:id="@+id/et_email"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_regular"
                            android:gravity="center_vertical|start"
                            android:hint="name@example.com"
                            android:importantForAutofill="no"
                            android:inputType="textEmailAddress"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textDirection="ltr"
                            android:textSize="@dimen/_12ssp" />

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_mail" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_mobile_number"
                        android:text="@string/profile_phone"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:paddingEnd="@dimen/_8sdp"
                            android:text="+966"
                            android:textColor="@color/text"
                            android:textSize="@dimen/_12ssp" />

                        <View
                            android:layout_width="1dp"
                            android:layout_height="@dimen/_20sdp"
                            android:background="#E6E0E0" />

                        <EditText
                            android:id="@+id/tv_mobile_number"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_regular"
                            android:gravity="center_vertical|start"
                            android:hint="5XXXXXXXX"
                            android:importantForAutofill="no"
                            android:inputType="phone"
                            android:maxLength="9"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textDirection="ltr"
                            android:textSize="@dimen/_12ssp" />

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_phone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_about"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_field"
                        android:text="@string/profile_field"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:id="@+id/layout_field"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_briefcase" />

                        <TextView
                            android:id="@+id/et_field"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_regular"
                            android:hint="@string/profile_choose_field"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_down" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_bio"
                        android:text="@string/profile_bio"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/et_bio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="top|start"
                        android:hint="@string/profile_bio_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:maxLength="200"
                        android:minLines="4"
                        android:padding="@dimen/_12sdp"
                        android:textColor="@color/text"
                        android:textColorHint="#9A9A9A"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/tv_bio_counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="end"
                        android:textColor="#6B6B6B"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_9ssp"
                        tools:text="0 / 200" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky save -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_bottom_bar"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_18sdp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_profile_save_btn"
                android:fontFamily="@font/somar_bold"
                android:text="@string/profile_save_changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />
        </FrameLayout>
    </LinearLayout>
</layout>
