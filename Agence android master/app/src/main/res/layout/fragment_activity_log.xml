<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_circle_light"
            android:padding="10dp"
            android:tint="@color/agence_black"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/ui_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/ui_activity_log"
            android:textColor="@color/agence_black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="40dp"
            android:layout_height="40dp" />

    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:scrollbars="none"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/ui_all"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_chip_selected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipTasks"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/ui_tasks"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/agence_black"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipMembers"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/ui_members"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/agence_black"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/chipPayments"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/ui_payments"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/agence_black"
                android:background="@drawable/bg_chip_unselected"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:gravity="center" />

        </LinearLayout>

    </HorizontalScrollView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvActivities"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:scrollbars="none" />

</LinearLayout>
