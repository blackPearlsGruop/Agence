<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:id="@+id/root_matched_provider"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:padding="@dimen/_11sdp"
        android:background="@drawable/bg_budget_option_default">

        <TextView
            android:id="@+id/tv_rank"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:fontFamily="@font/somar_regular"
            android:textColor="@color/agence_muted"
            android:textSize="@dimen/_11ssp"
            tools:text="1"/>

        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/_40sdp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_10sdp"
            app:cardCornerRadius="@dimen/_11sdp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_provider_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/backround_image"/>

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp">

            <TextView
                android:id="@+id/tv_provider_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_13ssp"
                tools:text="فهد العتيبي"/>

            <LinearLayout
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp">

                <RatingBar
                    android:id="@+id/rating_bar"
                    style="?android:attr/ratingBarStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:isIndicator="true"
                    android:numStars="5"
                    android:progressTint="#FEB702"
                    android:rating="4.5"
                    android:scaleX="0.7"
                    android:scaleY="0.7"
                    android:stepSize="0.1"/>

                <TextView
                    android:id="@+id/tv_provider_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_2sdp"
                    android:fontFamily="@font/somar_semi_bold"
                    android:textColor="@color/agence_orange"
                    android:textSize="@dimen/_10ssp"
                    tools:text="﷼ 5,000"/>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tv_rank_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:paddingHorizontal="@dimen/_7sdp"
            android:paddingVertical="@dimen/_2sdp"
            android:background="@drawable/bg_agence_pill_active"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/white"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone"
            tools:text="BEST"
            tools:visibility="visible"/>

        <FrameLayout
            android:layout_width="@dimen/_28sdp"
            android:layout_height="@dimen/_28sdp">

            <View
                android:id="@+id/score_ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_score_ring_blue"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/tv_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/somar_bold"
                    android:textColor="@color/agence_blue"
                    android:textSize="@dimen/_8ssp"
                    tools:text="96%"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/match_label"
                    android:fontFamily="@font/somar_regular"
                    android:textColor="@color/agence_muted"
                    android:textSize="5sp"/>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>
</layout>
