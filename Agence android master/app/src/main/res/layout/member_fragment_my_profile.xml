<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF4F4"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        tools:context="com.ksa.agence.member.ui.fragment.auth.MyProfileFragment">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_32sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_profile_back_btn"
                android:clickable="true"
                android:contentDescription="@string/profile_back"
                android:focusable="true"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/somar_bold"
                android:text="@string/profile_screen_title"
                android:textColor="@color/text"
                android:textSize="@dimen/_14ssp" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingBottom="@dimen/_14sdp">

                <!-- Identity card with cover -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/_16sdp">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_100sdp"
                        android:background="@drawable/bg_profile_cover">

                        <ImageView
                            android:id="@+id/iv_cover"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:importantForAccessibility="no"
                            android:scaleType="centerCrop" />

                        <LinearLayout
                            android:id="@+id/btn_change_cover"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_gravity="top|end"
                            android:layout_margin="@dimen/_10sdp"
                            android:background="@drawable/bg_profile_cover_btn"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/_10sdp"
                            android:paddingEnd="@dimen/_10sdp">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile_camera_blue" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:fontFamily="@font/somar_bold"
                                android:text="@string/profile_change_cover"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Logo overlapping the cover -->
                    <FrameLayout
                        android:layout_width="@dimen/_76sdp"
                        android:layout_height="@dimen/_76sdp"
                        android:layout_marginTop="-40dp">

                        <TextView
                            android:id="@+id/tv_logo_initial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_logo"
                            android:fontFamily="@font/somar_bold"
                            android:gravity="center"
                            android:textColor="#E96D07"
                            android:textSize="@dimen/_26ssp"
                            tools:text="أ" />

                        <ImageView
                            android:id="@+id/iv_logo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_profile_logo_img"
                            android:importantForAccessibility="no"
                            android:padding="4dp"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <FrameLayout
                            android:id="@+id/btn_change_logo"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="-4dp"
                            android:layout_marginBottom="-4dp"
                            android:background="@drawable/bg_profile_camera"
                            android:clickable="true"
                            android:contentDescription="@string/profile_change_photo"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="@dimen/_11sdp"
                                android:layout_height="@dimen/_11sdp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile_camera" />
                        </FrameLayout>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_nameUser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_14ssp"
                        tools:text="استوديو أثر" />

                    <LinearLayout
                        android:id="@+id/layout_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_12sdp"
                            android:layout_height="@dimen/_12sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_star" />

                        <TextView
                            android:id="@+id/tv_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:fontFamily="@font/somar_bold"
                            android:textColor="@color/text"
                            android:textSize="@dimen/_10ssp"
                            tools:text="4.8" />

                        <TextView
                            android:id="@+id/tv_rating_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_3sdp"
                            android:fontFamily="@font/somar_regular"
                            android:textColor="#5F5F5F"
                            android:textSize="@dimen/_10ssp"
                            tools:text="(62 تقييم)" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_profile_chip_member"
                            android:fontFamily="@font/somar_bold"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingTop="@dimen/_3sdp"
                            android:paddingEnd="@dimen/_12sdp"
                            android:paddingBottom="@dimen/_3sdp"
                            android:text="@string/profile_account_member"
                            android:textColor="#B85A0A"
                            android:textSize="@dimen/_9ssp" />

                        <TextView
                            android:id="@+id/tv_account_type_chip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:background="@drawable/bg_profile_chip"
                            android:fontFamily="@font/somar_bold"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingTop="@dimen/_3sdp"
                            android:paddingEnd="@dimen/_12sdp"
                            android:paddingBottom="@dimen/_3sdp"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/_9ssp"
                            android:visibility="gone"
                            tools:text="شركة"
                            tools:visibility="visible" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Basic information -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_basic"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_account_type"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:id="@+id/layout_account_type"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_segment_track"
                        android:orientation="horizontal"
                        android:padding="@dimen/_3sdp">

                        <TextView
                            android:id="@+id/tv_type_individual"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_bold"
                            android:gravity="center"
                            android:text="@string/profile_type_individual"
                            android:textColor="#5F5F5F"
                            android:textSize="@dimen/_11ssp" />

                        <TextView
                            android:id="@+id/tv_type_company"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_bold"
                            android:gravity="center"
                            android:text="@string/profile_type_company"
                            android:textColor="#5F5F5F"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_name_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_full_name"
                        android:text="@string/profile_org_name"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:id="@+id/iv_name_icon"
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_building" />

                        <EditText
                            android:id="@+id/tv_full_name"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_regular"
                            android:importantForAutofill="no"
                            android:inputType="textPersonName"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_nationality"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_10sdp"
                            android:fontFamily="@font/somar_bold"
                            android:text="@string/profile_nationality_id"
                            android:textColor="#3D3D3D"
                            android:textSize="@dimen/_10ssp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_42sdp"
                            android:layout_marginTop="@dimen/_5sdp"
                            android:background="@drawable/bg_profile_field"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingEnd="@dimen/_12sdp">

                            <ImageView
                                android:layout_width="@dimen/_15sdp"
                                android:layout_height="@dimen/_15sdp"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile_id" />

                            <TextView
                                android:id="@+id/tv_nationality_id"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_8sdp"
                                android:layout_weight="1"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/text"
                                android:textDirection="ltr"
                                android:textSize="@dimen/_12ssp" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_address"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:id="@+id/layout_address"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_location" />

                        <TextView
                            android:id="@+id/tv_address"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/somar_regular"
                            android:hint="@string/profile_address_hint"
                            android:maxLines="1"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />

                        <ImageView
                            android:layout_width="@dimen/_13sdp"
                            android:layout_height="@dimen/_13sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_chevron_down" />
                    </LinearLayout>
                </LinearLayout>

                <!-- About -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_about_org"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_about_you"
                        android:text="@string/profile_bio"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/tv_about_you"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="top|start"
                        android:hint="@string/profile_description_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:maxLength="300"
                        android:minLines="4"
                        android:padding="@dimen/_12sdp"
                        android:textColor="@color/text"
                        android:textColorHint="#9A9A9A"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/tv_bio_counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="end"
                        android:textColor="#6B6B6B"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_9ssp"
                        tools:text="0 / 300" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_bold"
                            android:text="@string/profile_services"
                            android:textColor="#3D3D3D"
                            android:textSize="@dimen/_10ssp" />

                        <TextView
                            android:id="@+id/btn_edit_services"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:padding="@dimen/_4sdp"
                            android:text="@string/profile_edit"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group_services"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        app:chipSpacingHorizontal="@dimen/_6sdp"
                        app:chipSpacingVertical="@dimen/_2sdp" />
                </LinearLayout>

                <!-- Consultations -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_section_consult"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/et_consult_price"
                        android:text="@string/profile_consult_price"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_profile_clock" />

                        <EditText
                            android:id="@+id/et_consult_price"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_regular"
                            android:hint="0"
                            android:importantForAutofill="no"
                            android:inputType="number"
                            android:maxLength="6"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:text="@string/profile_per_hour"
                            android:textColor="#5F5F5F"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Portfolio -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:text="@string/profile_section_works"
                            android:textColor="@color/text"
                            android:textSize="@dimen/_12ssp" />

                        <TextView
                            android:id="@+id/tv_works_count"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:layout_weight="1"
                            android:fontFamily="@font/somar_regular"
                            android:textColor="#5F5F5F"
                            android:textSize="@dimen/_10ssp"
                            tools:text="3 أعمال" />

                        <TextView
                            android:id="@+id/btn_view_all_works"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:padding="@dimen/_4sdp"
                            android:text="@string/profile_view_all"
                            android:textColor="@color/primary"
                            android:textSize="@dimen/_10ssp" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_works"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="-4dp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:layout_marginEnd="-4dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
                        app:spanCount="2"
                        tools:itemCount="4"
                        tools:listitem="@layout/item_profile_work" />
                </LinearLayout>

                <!-- Verification -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="@dimen/_36sdp"
                            android:layout_height="@dimen/_36sdp"
                            android:background="@drawable/bg_profile_icon_tile">

                            <ImageView
                                android:layout_width="@dimen/_18sdp"
                                android:layout_height="@dimen/_18sdp"
                                android:layout_gravity="center"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_profile_shield" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_10sdp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/somar_bold"
                                android:text="@string/profile_verify_title"
                                android:textColor="@color/text"
                                android:textSize="@dimen/_12ssp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:fontFamily="@font/somar_regular"
                                android:lineSpacingExtra="@dimen/_2sdp"
                                android:text="@string/profile_verify_desc"
                                android:textColor="#5F5F5F"
                                android:textSize="@dimen/_10ssp" />
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_request_verification"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/bg_profile_outline_btn"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/profile_verify_btn"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="@dimen/_11ssp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky save -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_bottom_bar"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_18sdp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_profile_save_btn"
                android:fontFamily="@font/somar_bold"
                android:text="@string/profile_save_changes"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />
        </FrameLayout>
    </LinearLayout>
</layout>
