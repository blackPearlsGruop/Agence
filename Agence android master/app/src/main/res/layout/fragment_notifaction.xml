<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF4F4"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        tools:context="com.ksa.agence.ui.fragment.notification.NotificationFragment">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_32sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_profile_back_btn"
                android:clickable="true"
                android:contentDescription="@string/profile_back"
                android:focusable="true"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/somar_bold"
                android:text="@string/notif_page_title"
                android:textColor="@color/text"
                android:textSize="@dimen/_14ssp" />
        </FrameLayout>

        <!-- Tabs: all / unread -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_14sdp"
            android:layout_marginTop="@dimen/_2sdp"
            android:layout_marginEnd="@dimen/_14sdp"
            android:background="@drawable/bg_notif_tabs_track"
            android:orientation="horizontal"
            android:padding="@dimen/_3sdp">

            <TextView
                android:id="@+id/btn_tab_all"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_weight="1"
                android:background="@drawable/bg_notif_tab_on"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/somar_bold"
                android:gravity="center"
                android:text="@string/notif_tab_all"
                android:textColor="@color/white"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:id="@+id/btn_tab_unread"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:layout_marginStart="@dimen/_4sdp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_tab_unread"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/somar_bold"
                    android:text="@string/notif_tab_unread"
                    android:textColor="#3D3D3D"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/tv_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_16sdp"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:background="@drawable/bg_notif_badge"
                    android:fontFamily="@font/somar_bold"
                    android:gravity="center"
                    android:minWidth="@dimen/_16sdp"
                    android:paddingStart="@dimen/_5sdp"
                    android:paddingEnd="@dimen/_5sdp"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_8ssp"
                    android:visibility="gone"
                    tools:text="3"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_notification"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingBottom="@dimen/_18sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_notification_card" />

            <LinearLayout
                android:id="@+id/layout_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="@dimen/_32sdp"
                android:paddingEnd="@dimen/_32sdp"
                android:paddingBottom="@dimen/_60sdp"
                android:visibility="gone"
                tools:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/_64sdp"
                    android:layout_height="@dimen/_64sdp"
                    android:background="@drawable/bg_notif_empty_tile"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/_18sdp"
                    android:src="@drawable/ic_notif_bell" />

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:fontFamily="@font/somar_bold"
                    android:gravity="center"
                    android:text="@string/notif_empty_title"
                    android:textColor="@color/text"
                    android:textSize="@dimen/_13ssp" />

                <TextView
                    android:id="@+id/tv_empty_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/somar_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="@dimen/_2sdp"
                    android:text="@string/notif_empty_desc"
                    android:textColor="#5F5F5F"
                    android:textSize="@dimen/_10ssp" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</layout>
