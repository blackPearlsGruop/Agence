<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_16sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingTop="@dimen/_24sdp"
            android:paddingBottom="@dimen/_24sdp">

            <!-- Header -->
            <TextView
                android:id="@+id/tv_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="@string/create_account"
                android:textColor="@color/text"
                android:textSize="@dimen/_20ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_regular"
                android:text="@string/tell_us_about_yourself"
                android:textColor="@color/gray"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_header" />

            <!-- Profile Image -->
            <FrameLayout
                android:id="@+id/fl_profile"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_marginTop="@dimen/_20sdp"
                android:background="@drawable/shape_circle_blue"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_subtitle">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👤"
                    android:textSize="@dimen/_40sdp" />

            </FrameLayout>

            <!-- Full Name Label -->
            <TextView
                android:id="@+id/tv_full_name_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/full_name"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_20sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fl_profile" />

            <EditText
                android:id="@+id/et_full_name"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/full_name"
                android:inputType="text"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_full_name_label" />

            <!-- Username Label -->
            <TextView
                android:id="@+id/tv_username_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/username"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_full_name" />

            <!-- Username (read-only, with @ prefix) -->
            <EditText
                android:id="@+id/et_username"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/username"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_username_label" />

            <!-- Email Label -->
            <TextView
                android:id="@+id/tv_email_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/email"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_username" />

            <EditText
                android:id="@+id/et_email"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_email_label" />

            <!-- Birth Date Label -->
            <TextView
                android:id="@+id/tv_birthdate_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/birth_date"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_email" />

            <!-- Birth Date (read-only) -->
            <EditText
                android:id="@+id/et_birthdate"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/birth_date"
                android:inputType="none"
                android:focusable="false"
                android:cursorVisible="false"
                android:longClickable="false"
                android:textIsSelectable="false"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_birthdate_label" />

            <!-- Professional Field Label -->
            <TextView
                android:id="@+id/tv_specialties_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/professional_field"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_birthdate" />

            <!-- Professional Field (text input) -->
            <EditText
                android:id="@+id/et_specialties"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/professional_field_hint"
                android:inputType="text"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_specialties_label" />

            <!-- Bio Label -->
            <TextView
                android:id="@+id/tv_bio_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/bio"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_14sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_specialties" />

            <EditText
                android:id="@+id/et_bio"
                style="@style/editText"
                android:layout_width="0dp"
                android:hint="@string/bio_hint"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="5"
                android:gravity="top"
                android:layout_marginTop="@dimen/_6sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_bio_label" />

            <!-- Portfolio Section -->
            <TextView
                android:id="@+id/tv_portfolio_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="@string/portfolio"
                android:textColor="@color/text"
                android:textSize="@dimen/_12ssp"
                android:layout_marginTop="@dimen/_18sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/et_bio" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_portfolio"
                android:layout_width="0dp"
                android:layout_height="@dimen/_40sdp"
                android:background="@drawable/shape_dashed_blue"
                android:text="@string/add_portfolio"
                android:textColor="@color/primary"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="@font/somar_semi_bold"
                android:textAllCaps="false"
                android:layout_marginTop="@dimen/_8sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_portfolio_label" />

            <!-- Verification Button (outlined) -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_verification"
                android:layout_width="0dp"
                android:layout_height="@dimen/_38sdp"
                android:background="@drawable/shape_outline_blue"
                android:text="@string/request_verification"
                android:textColor="@color/primary"
                android:textSize="@dimen/_13ssp"
                android:fontFamily="@font/somar_semi_bold"
                android:textAllCaps="false"
                android:layout_marginTop="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_add_portfolio" />

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/ll_buttons"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_16sdp"
                android:gravity="center"
                android:weightSum="2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_verification">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_back"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:background="@drawable/shape_bottom2"
                    android:text="@string/back"
                    android:textColor="@color/text"
                    android:textSize="@dimen/_13ssp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/somar_semi_bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_continue"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:background="@drawable/shape_bottom"
                    android:text="@string/continue_btn"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_13ssp"
                    android:textAllCaps="false"
                    android:fontFamily="@font/somar_semi_bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</layout>