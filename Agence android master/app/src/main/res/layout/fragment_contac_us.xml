                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/support_online_status" android:fontFamily="@font/somar_regular" android:textColor="#B3FFFFFF" android:textSize="@dimen/_9ssp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/chat_messages_container" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/_12sdp"/>

                    <LinearLayout android:orientation="horizontal" android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="@dimen/_10sdp" android:background="@drawable/bg_chat_widget_top_border">
