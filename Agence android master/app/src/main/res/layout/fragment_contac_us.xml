<layout xmlns:tools="http://schemas.android.com/tools" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">
    <data> </data>
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/agence_bg">
        <!--  Slim header (same pattern as Home/Account/Orders/Messages)  -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/_16sdp" android:layout_marginTop="@dimen/_14sdp" android:layout_marginBottom="@dimen/_10sdp" android:text="@string/support" android:fontFamily="@font/somar_bold" android:textSize="@dimen/_18ssp" android:textColor="@color/agence_black"/>
        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
