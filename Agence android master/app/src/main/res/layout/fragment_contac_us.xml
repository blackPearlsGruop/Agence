                        <FrameLayout android:id="@+id/btn_send_chat" android:layout_width="@dimen/_34sdp" android:layout_height="@dimen/_34sdp" android:layout_marginStart="@dimen/_8sdp" android:background="@drawable/bg_agence_send_circle">
                            <ImageView android:layout_width="@dimen/_14sdp" android:layout_height="@dimen/_14sdp" android:layout_gravity="center" android:src="@drawable/icon_send" app:tint="@color/white"/>
