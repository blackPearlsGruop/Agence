                <com.google.android.material.button.MaterialButton android:id="@+id/btn_start_chat" android:layout_width="match_parent" android:layout_height="@dimen/_42sdp" android:layout_marginHorizontal="@dimen/_16sdp" android:layout_marginTop="@dimen/_14sdp" android:backgroundTint="@color/agence_blue" android:drawableStart="@drawable/icon_support" android:drawablePadding="@dimen/_8sdp" app:drawableTint="@color/white" android:fontFamily="@font/somar_bold" android:text="@string/start_chat" android:textAllCaps="false" android:textColor="@color/white" android:textSize="@dimen/_13ssp" app:cornerRadius="999dp"/>

                <LinearLayout android:id="@+id/layout_chat_widget" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/_16sdp" android:layout_marginTop="@dimen/_14sdp" android:background="@drawable/bg_agence_card_shadow" android:visibility="gone">

