<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/agence_bg">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_14sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/featured_ad"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_16ssp"/>

            <FrameLayout
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:background="@drawable/bg_agence_chip_white">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_arrow_back"/>

            </FrameLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingBottom="@dimen/_20sdp">

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_14sdp"
                    android:padding="@dimen/_18sdp"
                    android:background="@drawable/bg_gradient_header_blue">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_14sdp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/tv_ad_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/somar_bold"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_16ssp"
                                tools:text="وكالة نجم"/>

                            <TextView
                                android:id="@+id/tv_ad_tagline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_3sdp"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="#CCFFFFFF"
                                android:textSize="@dimen/_11ssp"
                                tools:text="شريك الإعلانات المدفوعة الأول"/>

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:layout_width="@dimen/_48sdp"
                            android:layout_height="@dimen/_48sdp"
                            app:cardCornerRadius="@dimen/_13sdp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/iv_ad_photo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:scaleType="centerCrop"
                                android:src="@drawable/backround_image"/>

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_ad_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_14sdp"
                        android:padding="@dimen/_13sdp"
                        android:background="#1AFFFFFF"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        android:lineSpacingExtra="4dp"
                        tools:text="وكالة نجم هي الوكالة المرتبة الأولى في الإعلانات المدفوعة في المملكة العربية السعودية."/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_14sdp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:padding="@dimen/_10sdp"
                            android:background="#1AFFFFFF">

                            <TextView
                                android:id="@+id/tv_ad_stat1_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/somar_bold"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14ssp"
                                tools:text="★ 4.7"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="@string/rating_label"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="#B3FFFFFF"
                                android:textSize="@dimen/_8ssp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="@dimen/_3sdp"
                            android:padding="@dimen/_10sdp"
                            android:background="#1AFFFFFF">

                            <TextView
                                android:id="@+id/tv_ad_stat2_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/somar_bold"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14ssp"
                                tools:text="×4.2"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="ROAS"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="#B3FFFFFF"
                                android:textSize="@dimen/_8ssp"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:gravity="center"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:padding="@dimen/_10sdp"
                            android:background="#1AFFFFFF">

                            <TextView
                                android:id="@+id/tv_ad_stat3_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/somar_bold"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_14ssp"
                                tools:text="+30M ريال"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:text="@string/ad_spend_label"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="#B3FFFFFF"
                                android:textSize="@dimen/_8ssp"/>

                        </LinearLayout>

                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_full_profile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_42sdp"
                        android:backgroundTint="@color/agence_orange"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/view_full_profile"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13ssp"
                        app:cornerRadius="999dp"/>

                </LinearLayout>

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/_15sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:text="@string/what_is_featured_ad"
                        android:fontFamily="@font/somar_bold"
                        android:textColor="@color/agence_black"
                        android:textSize="@dimen/_13ssp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/featured_ad_explanation"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_muted"
                        android:textSize="@dimen/_12ssp"
                        android:lineSpacingExtra="4dp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>