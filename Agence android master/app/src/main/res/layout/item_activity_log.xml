<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layoutDirection="rtl"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_activity_card">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="AA"
            android:textSize="15sp"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/member_bg_avatar_circle" />

        <ImageView
            android:id="@+id/ivTypeIcon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_type_icon_circle"
            android:padding="3dp"
            android:tint="@color/agence_black"
            android:src="@android:drawable/ic_menu_agenda" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvActionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ui_fahad_al_otaibi_completed_the_task_pre"
            android:textSize="13sp"
            android:textColor="@color/agence_black"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_2_hours_ago"
            android:textSize="11sp"
            android:textColor="@color/gray"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
