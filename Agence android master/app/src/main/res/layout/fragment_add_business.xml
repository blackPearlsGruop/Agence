<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF4F4"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        tools:context="com.ksa.agence.member.ui.fragment.setting.AddBusinessFragment">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_32sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_8sdp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_36sdp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_profile_back_btn"
                android:clickable="true"
                android:contentDescription="@string/profile_back"
                android:focusable="true"
                android:padding="@dimen/_10sdp"
                android:src="@drawable/ic_profile_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/somar_bold"
                android:text="@string/works_add_title"
                android:textColor="@color/text"
                android:textSize="@dimen/_14ssp" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/_14sdp"
                android:paddingTop="@dimen/_4sdp"
                android:paddingEnd="@dimen/_14sdp"
                android:paddingBottom="@dimen/_14sdp">

                <!-- Image card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/works_image_section"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <FrameLayout
                        android:id="@+id/layout_upload"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_140sdp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:background="@drawable/bg_works_upload_tile"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:id="@+id/layout_upload_placeholder"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="@dimen/_40sdp"
                                android:layout_height="@dimen/_40sdp"
                                android:background="@drawable/bg_profile_icon_tile"
                                android:importantForAccessibility="no"
                                android:padding="@dimen/_10sdp"
                                android:src="@drawable/ic_works_upload" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:fontFamily="@font/somar_bold"
                                android:text="@string/works_upload_title"
                                android:textColor="@color/primary"
                                android:textSize="@dimen/_12ssp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:fontFamily="@font/somar_regular"
                                android:text="@string/works_upload_hint"
                                android:textColor="#6B6B6B"
                                android:textSize="@dimen/_9ssp" />
                        </LinearLayout>

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/iv_image"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/works_image_section"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            app:shapeAppearanceOverlay="@style/WorksImageShape" />

                        <TextView
                            android:id="@+id/tv_change_image"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="@dimen/_8sdp"
                            android:background="@drawable/bg_works_image_chip"
                            android:fontFamily="@font/somar_semi_bold"
                            android:paddingStart="@dimen/_12sdp"
                            android:paddingTop="@dimen/_5sdp"
                            android:paddingEnd="@dimen/_12sdp"
                            android:paddingBottom="@dimen/_5sdp"
                            android:text="@string/works_change_image"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_10ssp"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Details card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_12sdp"
                    android:background="@drawable/bg_profile_card"
                    android:elevation="1dp"
                    android:orientation="vertical"
                    android:padding="@dimen/_14sdp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/works_details_section"
                        android:textColor="@color/text"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_title"
                        android:text="@string/works_title_label"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_40sdp"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/_12sdp"
                        android:paddingEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="@dimen/_15sdp"
                            android:layout_height="@dimen/_15sdp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_works_title" />

                        <EditText
                            android:id="@+id/tv_title"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/somar_semi_bold"
                            android:hint="@string/works_title_hint"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences"
                            android:maxLength="100"
                            android:maxLines="1"
                            android:textColor="@color/text"
                            android:textColorHint="#9A9A9A"
                            android:textSize="@dimen/_11ssp" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_12sdp"
                        android:fontFamily="@font/somar_bold"
                        android:labelFor="@+id/tv_description"
                        android:text="@string/works_desc_label"
                        android:textColor="#3D3D3D"
                        android:textSize="@dimen/_10ssp" />

                    <EditText
                        android:id="@+id/tv_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_5sdp"
                        android:background="@drawable/bg_profile_field"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="top|start"
                        android:hint="@string/works_desc_hint"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:lineSpacingExtra="@dimen/_3sdp"
                        android:maxLength="300"
                        android:minLines="5"
                        android:padding="@dimen/_12sdp"
                        android:textColor="@color/text"
                        android:textColorHint="#9A9A9A"
                        android:textSize="@dimen/_11ssp" />

                    <TextView
                        android:id="@+id/tv_description_counter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:fontFamily="@font/somar_regular"
                        android:gravity="end"
                        android:textColor="#6B6B6B"
                        android:textDirection="ltr"
                        android:textSize="@dimen/_9ssp"
                        tools:text="0 / 300" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Sticky submit -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_profile_bottom_bar"
            android:paddingStart="@dimen/_14sdp"
            android:paddingTop="@dimen/_10sdp"
            android:paddingEnd="@dimen/_14sdp"
            android:paddingBottom="@dimen/_18sdp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_44sdp"
                android:background="@drawable/bg_profile_save_btn"
                android:fontFamily="@font/somar_bold"
                android:text="@string/works_submit"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />
        </FrameLayout>
    </LinearLayout>
</layout>
