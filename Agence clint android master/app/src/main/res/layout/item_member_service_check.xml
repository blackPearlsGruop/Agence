<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:padding="@dimen/_12sdp"
    android:background="@drawable/bg_agence_card_shadow">

    <ImageView
        android:layout_width="@dimen/_15sdp"
        android:layout_height="@dimen/_15sdp"
        android:src="@drawable/icon_check_circle"
        app:tint="@color/agence_blue"/>

    <TextView
        android:id="@+id/tv_service_name"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/somar_regular"
        android:textColor="@color/agence_black"
        android:textSize="@dimen/_12ssp"
        tools:text="تدقيق العلامة التجارية"
        xmlns:tools="http://schemas.android.com/tools"/>

</LinearLayout>
