<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/agence_bg">

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_14sdp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="@string/order_details"
                android:fontFamily="@font/somar_bold"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_16ssp"/>

            <FrameLayout
                android:id="@+id/iv_back"
                android:layout_width="@dimen/_34sdp"
                android:layout_height="@dimen/_34sdp"
                android:layout_marginStart="@dimen/_12sdp"
                android:background="@drawable/bg_agence_chip_white">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/icon_arrow_back"/>

            </FrameLayout>

        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/_16sdp"
                android:paddingBottom="@dimen/_20sdp">

                <!-- ═══ Accept + chat row ═══ -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_accept_offer"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="@dimen/_42sdp"
                        android:backgroundTint="@color/agence_blue"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/accept_offer"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_13ssp"
                        app:cornerRadius="999dp"/>

                    <FrameLayout
                        android:id="@+id/btn_chat"
                        android:layout_width="@dimen/_42sdp"
                        android:layout_height="@dimen/_42sdp"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:background="@drawable/bg_agence_chip_white">

                        <ImageView
                            android:layout_width="@dimen/_16sdp"
                            android:layout_height="@dimen/_16sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/icon_chat"
                            app:tint="@color/agence_black"/>

                    </FrameLayout>

                </LinearLayout>

                <!-- ═══ Provider mini card ═══ -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:padding="@dimen/_13sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/_48sdp"
                        android:layout_height="@dimen/_48sdp"
                        app:cardCornerRadius="@dimen/_12sdp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:id="@+id/iv_provider_photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/backround_image"/>

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp">

                        <TextView
                            android:id="@+id/tv_provider_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:textColor="@color/agence_black"
                            android:textSize="@dimen/_13ssp"
                            tools:text="فهد العتيبي"/>

                        <TextView
                            android:id="@+id/tv_provider_agency"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_1sdp"
                            android:fontFamily="@font/somar_semi_bold"
                            android:textColor="@color/agence_orange"
                            android:textSize="@dimen/_10ssp"
                            tools:text="وكالة الرواد للتسويق"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_provider_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/icon_star_filled"
                        android:drawablePadding="@dimen/_3sdp"
                        android:fontFamily="@font/somar_bold"
                        android:textColor="@color/agence_black"
                        android:textSize="@dimen/_12ssp"
                        tools:text="4.9"/>

                </LinearLayout>

                <!-- ═══ Info grid ═══ -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:padding="@dimen/_11sdp"
                            android:background="@drawable/bg_agence_card_shadow">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/start_date"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/agence_muted"
                                android:textSize="@dimen/_9ssp"/>

                            <TextView
                                android:id="@+id/tv_start_date"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:drawableStart="@drawable/icon_calendr"
                                android:drawablePadding="@dimen/_4sdp"
                                android:fontFamily="@font/somar_semi_bold"
                                android:textColor="@color/agence_black"
                                android:textSize="@dimen/_11ssp"
                                tools:text="14 يوليو 2026"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:padding="@dimen/_11sdp"
                            android:background="@drawable/bg_agence_card_shadow">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/location"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/agence_muted"
                                android:textSize="@dimen/_9ssp"/>

                            <TextView
                                android:id="@+id/tv_order_location"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:drawableStart="@drawable/icon_location"
                                android:drawablePadding="@dimen/_4sdp"
                                android:fontFamily="@font/somar_semi_bold"
                                android:textColor="@color/agence_black"
                                android:textSize="@dimen/_11ssp"
                                tools:text="الرياض"/>

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_4sdp"
                            android:padding="@dimen/_11sdp"
                            android:background="@drawable/bg_agence_card_shadow">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/order_hash"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/agence_muted"
                                android:textSize="@dimen/_9ssp"/>

                            <TextView
                                android:id="@+id/tv_order_no"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:fontFamily="@font/somar_semi_bold"
                                android:textColor="@color/agence_black"
                                android:textSize="@dimen/_11ssp"
                                tools:text="ORD-00419"/>

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:padding="@dimen/_11sdp"
                            android:background="@drawable/bg_agence_card_shadow">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/duration"
                                android:fontFamily="@font/somar_regular"
                                android:textColor="@color/agence_muted"
                                android:textSize="@dimen/_9ssp"/>

                            <TextView
                                android:id="@+id/tv_order_duration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_4sdp"
                                android:drawableStart="@drawable/icon_clock_small"
                                android:drawablePadding="@dimen/_4sdp"
                                app:drawableTint="@color/agence_blue"
                                android:fontFamily="@font/somar_semi_bold"
                                android:textColor="@color/agence_black"
                                android:textSize="@dimen/_11ssp"
                                tools:text="أسبوعان"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <!-- ═══ Price card ═══ -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:padding="@dimen/_16sdp"
                    android:background="@drawable/bg_gradient_header_blue">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_price"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="#8CFFFFFF"
                        android:textSize="@dimen/_9ssp"
                        android:letterSpacing="0.05"/>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp">

                        <TextView
                            android:id="@+id/tv_total_price"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/somar_bold"
                            android:textColor="@color/agence_orange"
                            android:textSize="@dimen/_24ssp"
                            tools:text="﷼ 5,000"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/fixed_price"
                            android:fontFamily="@font/somar_regular"
                            android:textColor="#80FFFFFF"
                            android:textSize="@dimen/_9ssp"/>

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/_10sdp"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:background="#1AFFFFFF"/>

                    <TextView
                        android:id="@+id/tv_service_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_semi_bold"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_12ssp"
                        tools:text="تدقيق العلامة التجارية والتموضع"/>

                </LinearLayout>

                <!-- ═══ Service contents (steps) ═══ -->
                <LinearLayout
                    android:id="@+id/layout_steps"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:padding="@dimen/_14sdp"
                    android:background="@drawable/bg_agence_card_shadow">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:text="@string/service_contents"
                        android:fontFamily="@font/somar_regular"
                        android:textColor="@color/agence_muted"
                        android:textSize="@dimen/_10ssp"
                        android:letterSpacing="0.05"/>

                    <!-- Step rows added at runtime -->

                </LinearLayout>

                <!-- ═══ Bottom actions ═══ -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_reorder"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:backgroundTint="@color/agence_bg"
                        android:fontFamily="@font/somar_semi_bold"
                        android:text="@string/reorder"
                        android:textAllCaps="false"
                        android:textColor="@color/agence_blue"
                        android:textSize="@dimen/_11ssp"
                        app:cornerRadius="999dp"
                        app:strokeColor="@color/agence_blue"
                        app:strokeWidth="@dimen/_1sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_evaluation"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="@dimen/_38sdp"
                        android:layout_marginStart="@dimen/_6sdp"
                        android:backgroundTint="@color/agence_bg"
                        android:fontFamily="@font/somar_semi_bold"
                        android:text="@string/evaluation"
                        android:textAllCaps="false"
                        android:textColor="@color/agence_orange"
                        android:textSize="@dimen/_11ssp"
                        app:cornerRadius="999dp"
                        app:strokeColor="@color/agence_orange"
                        app:strokeWidth="@dimen/_1sdp"/>

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>
</layout>
