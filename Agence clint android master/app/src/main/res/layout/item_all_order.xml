<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16sdp"
        android:layout_marginVertical="@dimen/_6sdp"
        android:background="@drawable/bg_agence_card_shadow"
        android:padding="@dimen/_14sdp">

        <TextView
            android:id="@+id/tvNameCategory"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_8sdp"
            android:fontFamily="@font/somar_bold"
            android:text="خدمة تسويق لمدة شهر"
            android:textColor="@color/agence_black"
            android:textSize="@dimen/_13ssp"
            app:layout_constraintEnd_toStartOf="@+id/tv_status_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:fontFamily="@font/somar_semi_bold"
            android:textSize="@dimen/_9ssp"
            android:background="@drawable/bg_status_blue"
            android:textColor="@color/agence_blue"
            tools:text="قيد التنفيذ"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_no_order"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_3sdp"
            android:fontFamily="@font/somar_regular"
            android:text="0000000"
            android:textColor="@color/agence_muted"
            android:textSize="@dimen/_10ssp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNameCategory" />

        <View
            android:id="@+id/view5"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@color/agence_border"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_no_order" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraint_data_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            app:layout_constraintTop_toBottomOf="@+id/view5">


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_logo_company"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="@dimen/_40sdp"
                android:src="@drawable/backround_image"
                app:civ_border_color="@color/agence_bg"
                app:civ_border_width="@dimen/_2sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_name_company"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/somar_bold"
                android:text="اسم الشركة"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_12ssp"
                app:layout_constraintEnd_toStartOf="@+id/tv_price_service"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_company"
                app:layout_constraintTop_toTopOf="@+id/iv_logo_company" />

            <ImageView
                android:id="@+id/iv_order_date"
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:src="@drawable/icon_calendr"
                app:tint="@color/agence_muted"
                app:layout_constraintStart_toEndOf="@+id/iv_logo_company"
                app:layout_constraintTop_toBottomOf="@+id/tv_name_company" />

            <TextView
                android:id="@+id/tv_order_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:fontFamily="@font/somar_regular"
                android:textColor="@color/agence_muted"
                android:textSize="@dimen/_10ssp"
                tools:text="15 أغسطس"
                app:layout_constraintStart_toEndOf="@+id/iv_order_date"
                app:layout_constraintTop_toTopOf="@+id/iv_order_date"
                app:layout_constraintBottom_toBottomOf="@+id/iv_order_date" />


            <TextView
                android:id="@+id/tv_price_service"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="150 ر.س"
                android:textColor="@color/agence_orange"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_name_company"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_name_company" />


            <TextView
                android:id="@+id/tv_address_company"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:drawableStart="@drawable/icon_location"
                android:drawablePadding="@dimen/_4sdp"
                android:fontFamily="@font/somar_regular"
                android:text="الرياض , السعودية"
                android:textAlignment="viewStart"
                android:textColor="@color/agence_muted"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/iv_logo_company"
                app:layout_constraintTop_toBottomOf="@+id/iv_order_date" />


        </androidx.constraintlayout.widget.ConstraintLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_show"
            android:layout_width="0dp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginTop="@dimen/_12sdp"
            android:backgroundTint="@color/agence_orange"
            android:fontFamily="@font/somar_bold"
            android:text="@string/show"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp"
            app:cornerRadius="999dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_chat_order"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraint_data_company" />


        <FrameLayout
            android:id="@+id/iv_chat_order"
            android:layout_width="@dimen/_32sdp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_status_blue"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/btn_show"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_show">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="center"
                android:src="@drawable/icon_chat_order"
                app:tint="@color/agence_blue"/>

        </FrameLayout>


        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reorder"
            android:layout_width="0dp"
            android:layout_height="@dimen/_32sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:backgroundTint="@color/agence_bg"
            android:fontFamily="@font/somar_bold"
            android:text="@string/reorder"
            android:textAllCaps="false"
            android:textColor="@color/agence_blue"
            android:textSize="@dimen/_11ssp"
            android:visibility="gone"
            app:cornerRadius="999dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_show"
            app:strokeColor="@color/agence_blue"
            app:strokeWidth="@dimen/_1sdp" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
