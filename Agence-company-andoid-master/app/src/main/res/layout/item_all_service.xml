<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <ru.rambler.libs.swipe_layout.SwipeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        android:id="@+id/item_notification_swipe"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp">



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/_8sdp"
            app:cardElevation="@dimen/_1sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:padding="@dimen/_10sdp">


                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_logo_service"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:src="@drawable/logo_splash"
                    app:civ_border_color="@color/primary"
                    app:civ_border_width="@dimen/_1sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:fontFamily="@font/somar_bold"
                    android:text="اسم الشركة"
                    android:textColor="@color/text"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintEnd_toStartOf="@+id/btn_show"
                    app:layout_constraintStart_toEndOf="@+id/iv_logo_service"
                    app:layout_constraintTop_toTopOf="@+id/iv_logo_service" />


                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/somar_regular"
                    android:inputType="textMultiLine"
                    android:text="00"
                    android:textAlignment="viewStart"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:textColor="@color/grey_bold"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintEnd_toStartOf="@+id/btn_show"
                    app:layout_constraintStart_toStartOf="@+id/tv_name"
                    app:layout_constraintTop_toBottomOf="@+id/tv_name" />


                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_show"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_28sdp"
                    android:background="@drawable/shape_bottom"
                    android:fontFamily="@font/somar_bold"
                    android:text="@string/show"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_14ssp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.cardview.widget.CardView>



    <!--    </LinearLayout>-->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:bring_to_clamp="@dimen/_60sdp"
        app:clamp="self"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:gravity="center"
        app:gravity="right"
        tools:ignore="MissingPrefix">


        <ImageView
            android:id="@+id/item_update"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_update"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_gravity="center"
            android:gravity="center" />


    </LinearLayout>


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        app:bring_to_clamp="@dimen/_60sdp"
        app:clamp="self"
        android:layout_marginStart="@dimen/_16sdp"
        android:layout_marginEnd="@dimen/_16sdp"
        android:gravity="center"
        app:gravity="left"
        tools:ignore="MissingPrefix">


        <ImageView
            android:id="@+id/item_delete"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="match_parent"
            android:src="@drawable/ic_delete"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:layout_gravity="center"
            android:gravity="center" />


    </LinearLayout>

    </ru.rambler.libs.swipe_layout.SwipeLayout>

</layout>