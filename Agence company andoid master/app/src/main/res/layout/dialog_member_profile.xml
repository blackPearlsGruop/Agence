<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/_20sdp"
    android:background="@drawable/bg_agence_profile_card">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_profile_initials"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circle"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/white"
            android:textSize="@dimen/_14ssp"/>

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp">

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:textSize="@dimen/_14ssp"
                android:textColor="@color/agence_black"/>

            <TextView
                android:id="@+id/tv_profile_specialty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/somar_regular"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/agence_muted"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp">

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/_6sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_pill_blue_light">

            <TextView
                android:id="@+id/tv_profile_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/primary"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/role_label"
                android:fontFamily="@font/somar_regular"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/agence_muted"/>

        </LinearLayout>

        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_6sdp"
            android:padding="@dimen/_10sdp"
            android:background="@drawable/bg_pill_green_light">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/active_label"
                android:fontFamily="@font/somar_bold"
                android:textSize="@dimen/_11ssp"
                android:textColor="@color/green"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_label"
                android:fontFamily="@font/somar_regular"
                android:textSize="@dimen/_9ssp"
                android:textColor="@color/agence_muted"/>

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_profile_close"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_14sdp"
        android:gravity="center"
        android:padding="@dimen/_12sdp"
        android:text="@string/close"
        android:fontFamily="@font/somar_semi_bold"
        android:textSize="@dimen/_12ssp"
        android:textColor="@color/agence_muted"
        android:background="@drawable/bg_circle_light_grey"/>

</LinearLayout>
