<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="48dp"
        android:paddingBottom="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:gravity="center_vertical"
        android:background="@color/white">

        <ImageView
            android:id="@+id/ivBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back"
            android:contentDescription="رجوع"
            android:scaleType="centerInside"
            android:tint="@color/agence_black" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="توزيع المدفوعات"
            android:textColor="@color/agence_black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="24dp"
            android:layout_height="24dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_payment_card"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="قيمة المشروع الإجمالية"
                        android:textSize="12sp"
                        android:textColor="@color/white"
                        android:alpha="0.85" />

                    <EditText
                        android:id="@+id/etTotalAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10000.00"
                        android:textSize="24sp"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:inputType="numberDecimal"
                        android:background="@android:color/transparent"
                        android:layout_marginTop="6dp"
                        android:minWidth="150dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="شامل الضريبة 15%"
                        android:textSize="10sp"
                        android:textColor="@color/white"
                        android:alpha="0.7"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المبلغ المخصص لكل عضو"
                android:textSize="14sp"
                android:textColor="@color/agence_black"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnEqualDistribution"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="توزيع متساوي"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_orange"
                android:backgroundTint="@null"
                android:layout_marginBottom="12dp"
                android:stateListAnimator="@null"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPayments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8F5E9"
                android:padding="12dp"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:layoutDirection="rtl">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_back"
                    android:tint="#4CAF50"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="متوازن"
                    android:textSize="14sp"
                    android:textColor="#4CAF50"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الإجمالي: "
                    android:textSize="12sp"
                    android:textColor="@color/agence_black" />

                <TextView
                    android:id="@+id/tvTotalDistributed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ر.س 10000.00"
                    android:textSize="13sp"
                    android:textColor="@color/agence_black"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnConfirmDistribution"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="حفظ التوزيع"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_blue"
                    android:layout_marginEnd="8dp"
                    android:stateListAnimator="@null"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnResetDistribution"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="تصدير PDF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#2505ED"
                    android:background="@drawable/bg_button_white_outline"
                    android:backgroundTint="@null"
                    android:layout_marginStart="8dp"
                    android:stateListAnimator="@null"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>