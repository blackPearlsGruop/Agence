<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/_250sdp"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        app:cardCornerRadius="@dimen/_16sdp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:layout_marginStart="@dimen/_16sdp">




        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_bottom2">




            <View
                android:id="@+id/view2"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_80sdp"
                android:layout_margin="@dimen/_16sdp"
                android:background="@drawable/logo_splash"
                android:alpha="0.10"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="@string/today_s_show"
                android:layout_marginStart="@dimen/_16sdp"
                android:textSize="@dimen/_20ssp"
                android:textColor="@color/secondary"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="00 رس"
                android:textAlignment="center"
                android:textColor="@color/secondary"
                android:textSize="@dimen/_18ssp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_next_payment"
                app:layout_constraintEnd_toEndOf="@+id/btn_details" />


            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_regular"
                android:text="@string/next_payment"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/_16sdp"
                android:textColor="@color/secondary"
                android:textSize="@dimen/_18ssp"
                app:layout_constraintStart_toStartOf="@+id/tv_duration"
                app:layout_constraintTop_toBottomOf="@+id/tv_duration" />


            <TextView
                android:id="@+id/tv_next_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="@string/next_payment"
                android:textAlignment="center"
                android:textColor="@color/secondary"
                android:textSize="@dimen/_18ssp"
                app:layout_constraintStart_toStartOf="@+id/tv_duration"
                app:layout_constraintTop_toBottomOf="@+id/title" />




            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_details"
                style="@style/bottom"
                android:layout_width="0dp"
                android:layout_height="@dimen/_30sdp"
                android:background="@drawable/shape_bottom"
                android:backgroundTint="@color/secondary"
                android:text="@string/details"
                android:textSize="@dimen/_16ssp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_duration"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_duration" />


        </androidx.constraintlayout.widget.ConstraintLayout>



    </androidx.cardview.widget.CardView>
</layout>