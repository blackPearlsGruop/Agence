<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_user_login"
                android:layout_width="@dimen/_100sdp"
                android:layout_height="@dimen/_100sdp"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/_24sdp"
                android:src="@drawable/backround_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_nameUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="@string/register_an_account"
                android:textColor="@color/text"
                android:textSize="@dimen/_20ssp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_user_login" />


            <TextView
                android:id="@+id/tv_change_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_regular"
                android:text="@string/change_photo"
                android:textColor="@color/secondary"
                android:textSize="@dimen/_16ssp"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_nameUser" />



            <EditText
                android:id="@+id/tv_full_name"
                style="@style/editText"
                android:layout_width="0dp"
                android:drawableStart="@drawable/icon_person"
                android:drawablePadding="@dimen/_4sdp"
                android:hint="@string/full_name"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_change_photo" />


            <TextView
                android:id="@+id/tv_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:background="@drawable/shape_text"
                android:drawablePadding="@dimen/_8sdp"
                android:fontFamily="@font/somar_regular"
                android:hint="@string/address"
                android:padding="@dimen/_12sdp"
                android:textAlignment="viewStart"
                android:textSize="@dimen/_16ssp"
                app:drawableStartCompat="@drawable/icon_location"
                app:layout_constraintEnd_toEndOf="@+id/tv_full_name"
                app:layout_constraintStart_toStartOf="@+id/tv_full_name"
                app:layout_constraintTop_toBottomOf="@+id/tv_full_name" />






            <EditText
                android:id="@+id/tv_nationality_id"
                style="@style/editText"
                android:layout_width="0dp"
                android:drawableStart="@drawable/icon_nationality_id"
                android:drawablePadding="@dimen/_4sdp"
                android:layout_marginTop="@dimen/_16sdp"
                android:hint="@string/nationality_id"
                android:enabled="false"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_address" />




            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraint_selected_categories"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_text"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:orientation="horizontal"
                android:padding="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_marginStart="@dimen/_16sdp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintStart_toStartOf="parent"
                tools:listitem="@layout/item_multi_choice_items"
                app:layout_constraintTop_toBottomOf="@+id/tv_nationality_id" >


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/constraint_open"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/_4sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_open"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/icon_arrow_down"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/somar_bold"
                        android:text="@string/services"
                        android:textColor="@color/grey_bold"
                        android:textSize="@dimen/_18ssp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>


                <View
                    android:id="@+id/viewRv"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:background="@color/grey"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/constraint_open" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_selected_categories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/_4sdp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/viewRv"
                    tools:listitem="@layout/item_multi_choice_items" />





            </androidx.constraintlayout.widget.ConstraintLayout>



            <EditText
                android:id="@+id/tv_about_you"
                style="@style/editText"
                android:layout_width="0dp"
                android:lines="3"
                android:gravity="top"
                android:hint="@string/about_you"
                android:layout_marginTop="@dimen/_16sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/constraint_selected_categories" />




            <TextView
                android:id="@+id/title_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_bold"
                android:text="@string/add_a_background_image"
                android:textColor="@color/white"
                android:layout_marginTop="@dimen/_16sdp"
                android:padding="@dimen/_8sdp"
                android:layout_marginStart="@dimen/_16sdp"
                android:textSize="@dimen/_16ssp"
                android:background="@drawable/shape_bottom"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_about_you" />

            <ImageView
                android:id="@+id/iv_image"
                android:layout_width="@dimen/_85sdp"
                android:layout_height="@dimen/_65sdp"
                android:src="@drawable/icon_frame"
                android:layout_marginTop="@dimen/_10sdp"
                app:layout_constraintStart_toStartOf="@+id/title_image"
                app:layout_constraintTop_toBottomOf="@+id/title_image" />


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save"
                style="@style/bottom"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/_24sdp"
                android:text="@string/save"
                android:layout_marginBottom="@dimen/_16sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_image" />


        </androidx.constraintlayout.widget.ConstraintLayout>


    </ScrollView>
</layout>