<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_new_task_sheet"
        android:clipToPadding="false"
        android:padding="@dimen/_16sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Handle -->
            <View
                android:layout_width="@dimen/_36sdp"
                android:layout_height="@dimen/_4sdp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/_12sdp"
                android:background="@drawable/bg_sheet_handle" />

            <!-- Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/_16sdp">

                <TextView
                    android:id="@+id/tv_sheet_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/somar_bold"
                    android:text="مهمة جديدة"
                    android:textColor="@color/agence_black"
                    android:textSize="@dimen/_16ssp" />

                <ImageView
                    android:id="@+id/btn_close_sheet"
                    android:layout_width="@dimen/_30sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_sheet_close"
                    android:padding="@dimen/_6sdp"
                    android:src="@drawable/ic_close_x"
                    app:tint="@color/agence_black" />

            </RelativeLayout>

            <!-- Task name field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="عنوان المهمة"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <EditText
                android:id="@+id/et_task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:background="@drawable/bg_task_input"
                android:fontFamily="@font/somar_regular"
                android:hint="مثال: تحليل المنافسين"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp"
                android:textColor="@color/agence_black"
                android:textColorHint="#A0A0A8"
                android:textSize="@dimen/_12ssp" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="وصف المهمة"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <EditText
                android:id="@+id/et_task_description"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_80sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:background="@drawable/bg_task_input"
                android:fontFamily="@font/somar_regular"
                android:gravity="top|start"
                android:hint="اكتب تفاصيل المهمة والمخرجات المطلوبة"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_10sdp"
                android:textColor="@color/agence_black"
                android:textColorHint="#A0A0A8"
                android:textSize="@dimen/_12ssp" />

            <!-- Assignee -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="المسؤول"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:id="@+id/row_assignee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:background="@drawable/bg_task_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_10sdp">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="#7B7B85" />

                <TextView
                    android:id="@+id/tv_assignee"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/somar_semi_bold"
                    android:text="فهد العتيبي"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/agence_black"
                    android:textSize="@dimen/_12ssp" />

                <TextView
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:background="@drawable/bg_avatar_circle"
                    android:backgroundTint="@color/agence_blue"
                    android:fontFamily="@font/somar_bold"
                    android:gravity="center"
                    android:text="FA"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_9ssp" />

            </LinearLayout>

            <!-- Due Date -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="تاريخ التسليم"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:id="@+id/row_due_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:background="@drawable/bg_task_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/_14sdp"
                android:paddingVertical="@dimen/_12sdp">

                <ImageView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    android:src="@drawable/ic_calendar_small"
                    app:tint="#7B7B85" />

                <TextView
                    android:id="@+id/tv_due_date"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:layout_weight="1"
                    android:fontFamily="@font/somar_semi_bold"
                    android:text="٣٠ يوليو ٢٠٢٦"
                    android:textAlignment="viewEnd"
                    android:textColor="@color/agence_black"
                    android:textSize="@dimen/_12ssp" />

            </LinearLayout>

            <!-- Priority chips -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="الأولوية"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_14sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_priority_high"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_priority_chip"
                    android:fontFamily="@font/somar_semi_bold"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="عالية"
                    android:textColor="#7B7B85"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/chip_priority_med"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_3sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_priority_chip_med_selected"
                    android:fontFamily="@font/somar_bold"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="متوسطة"
                    android:textColor="#F58220"
                    android:textSize="@dimen/_11ssp" />

                <TextView
                    android:id="@+id/chip_priority_low"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_priority_chip"
                    android:fontFamily="@font/somar_semi_bold"
                    android:gravity="center"
                    android:paddingVertical="@dimen/_8sdp"
                    android:text="منخفضة"
                    android:textColor="#7B7B85"
                    android:textSize="@dimen/_11ssp" />

            </LinearLayout>

            <!-- Attachments -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/somar_semi_bold"
                android:text="المرفقات"
                android:textColor="@color/agence_black"
                android:textSize="@dimen/_11ssp" />

            <LinearLayout
                android:id="@+id/box_attach"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:background="@drawable/bg_attach_dashed"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_18sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/somar_regular"
                    android:text="📎 اضغط لإرفاق ملف أو صورة"
                    android:textColor="#7B7B85"
                    android:textSize="@dimen/_11ssp" />

            </LinearLayout>

            <!-- Save button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_46sdp"
                android:background="@drawable/bg_team_fab"
                android:fontFamily="@font/somar_bold"
                android:text="حفظ المهمة"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_13ssp" />

            <TextView
                android:id="@+id/btn_cancel_sheet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:fontFamily="@font/somar_semi_bold"
                android:gravity="center"
                android:padding="@dimen/_10sdp"
                android:text="إلغاء"
                android:textColor="#7B7B85"
                android:textSize="@dimen/_12ssp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</layout>
