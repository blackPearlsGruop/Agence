<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_team_task_card"
    android:padding="@dimen/_14sdp">

    <ImageView
        android:id="@+id/iv_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_dots_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#A0A0A8" />

    <TextView
        android:id="@+id/tv_task_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:fontFamily="@font/somar_semi_bold"
        android:text="تحليل الهوية الحالية والمنافسين"
        android:textAlignment="viewEnd"
        android:textColor="@color/agence_black"
        android:textSize="@dimen/_13ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_menu"
        app:layout_constraintTop_toTopOf="parent" />

    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_assignee_avatar"
        android:layout_width="@dimen/_26sdp"
        android:layout_height="@dimen/_26sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@color/agence_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_task_title" />

    <TextView
        android:id="@+id/tv_assignee_initials"
        android:layout_width="@dimen/_26sdp"
        android:layout_height="@dimen/_26sdp"
        android:fontFamily="@font/somar_bold"
        android:gravity="center"
        android:text="FA"
        android:textColor="@color/white"
        android:textSize="@dimen/_8ssp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_assignee_avatar"
        app:layout_constraintEnd_toEndOf="@+id/iv_assignee_avatar"
        app:layout_constraintStart_toStartOf="@+id/iv_assignee_avatar"
        app:layout_constraintTop_toTopOf="@+id/iv_assignee_avatar" />

    <TextView
        android:id="@+id/tv_assignee_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_8sdp"
        android:fontFamily="@font/somar_semi_bold"
        android:text="فهد العتيبي"
        android:textAlignment="viewEnd"
        android:textColor="#7B7B85"
        android:textSize="@dimen/_10ssp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_assignee_avatar"
        app:layout_constraintEnd_toStartOf="@+id/iv_assignee_avatar"
        app:layout_constraintStart_toEndOf="@+id/status_pill"
        app:layout_constraintTop_toTopOf="@+id/iv_assignee_avatar" />

    <TextView
        android:id="@+id/status_pill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_team_pill_progress"
        android:fontFamily="@font/somar_bold"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:text="قيد التنفيذ"
        android:textColor="#F58220"
        android:textSize="@dimen/_9ssp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_assignee_avatar"
        app:layout_constraintStart_toEndOf="@+id/iv_menu"
        app:layout_constraintTop_toTopOf="@+id/iv_assignee_avatar" />

    <TextView
        android:id="@+id/tv_due_date"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_8sdp"
        android:drawableEnd="@drawable/ic_calendar_small"
        android:drawablePadding="@dimen/_4sdp"
        android:fontFamily="@font/somar_regular"
        android:text="غداً · ٣٠ يوليو"
        android:textAlignment="viewEnd"
        android:textColor="#7B7B85"
        android:textSize="@dimen/_9ssp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_menu"
        app:layout_constraintTop_toBottomOf="@+id/iv_assignee_avatar" />

</androidx.constraintlayout.widget.ConstraintLayout>
