<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/_8sdp"
    android:padding="@dimen/_14sdp"
    android:background="@drawable/shape_text">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_opportunity_title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/text"
            android:textSize="@dimen/_13ssp"
            tools:text="إعداد حملة إعلانات جوجل"/>

        <TextView
            android:id="@+id/tv_opportunity_budget"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/primary"
            android:textSize="@dimen/_13ssp"
            tools:text="ريال 150/hr"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tv_opportunity_company"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/somar_regular"
        android:textColor="@color/grey_bold"
        android:textSize="@dimen/_10ssp"
        tools:text="صيدلية المدينة"/>

    <LinearLayout
        android:id="@+id/layout_opportunity_tags"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"/>

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_12sdp">

        <TextView
            android:id="@+id/btn_opportunity_apply"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:background="@drawable/bg_smart_matching_btn"
            android:backgroundTint="@color/primary"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/white"
            android:textSize="@dimen/_11ssp"
            android:text="@string/apply_now"/>

        <TextView
            android:id="@+id/tv_opportunity_deadline"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:drawableStart="@drawable/icon_calendar"
            android:drawablePadding="@dimen/_4sdp"
            android:fontFamily="@font/somar_regular"
            android:textColor="@color/grey_bold"
            android:textSize="@dimen/_10ssp"
            tools:text="الموعد النهائي: 15 أغسطس 2026"/>

    </LinearLayout>

</LinearLayout>
