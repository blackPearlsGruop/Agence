<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>

    </data>

    <ru.rambler.libs.swipe_layout.SwipeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/_4sdp"
        android:layout_marginVertical="@dimen/_8sdp"
        android:layout_marginHorizontal="@dimen/_16sdp">



        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="@dimen/_8sdp"
            android:layout_marginVertical="@dimen/_8sdp"
            android:layout_marginHorizontal="@dimen/_16sdp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_12sdp"
                android:background="@drawable/shape_text">


                <ImageView
                    android:id="@+id/iv_work_file"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_70sdp"
                    android:src="@mipmap/logo_app"
                    android:scaleType="fitXY"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="0dp"
                    android:layout_marginEnd="@dimen/_8sdp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/somar_bold"
                    android:text="شركة استشارة"
                    android:textColor="@color/text"
                    android:textSize="@dimen/_20ssp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_work_file"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/iv_work_file" />


                <TextView
                    android:id="@+id/tv_description"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:fontFamily="@font/somar_regular"
                    android:text="خدمة استشارة"
                    android:textColor="@color/grey_bold"
                    android:textSize="@dimen/_18ssp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_work_file"
                    app:layout_constraintStart_toStartOf="@+id/tv_title"
                    app:layout_constraintTop_toBottomOf="@+id/tv_title" />




            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.cardview.widget.CardView>




        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:bring_to_clamp="@dimen/_60sdp"
            app:clamp="self"
            android:layout_marginStart="@dimen/_16sdp"
            android:layout_marginEnd="@dimen/_16sdp"
            android:gravity="center"
            app:gravity="left"
            tools:ignore="MissingPrefix">


            <ImageView
                android:id="@+id/item_delete"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_delete"
                android:layout_marginStart="@dimen/_16sdp"
                android:layout_marginEnd="@dimen/_16sdp"
                android:layout_gravity="center"
                android:gravity="center" />


        </LinearLayout>

    </ru.rambler.libs.swipe_layout.SwipeLayout>

</layout>