<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_bottom"
        android:backgroundTint="@color/white"
        android:elevation="@dimen/_3sdp"
        android:layout_margin="@dimen/_8sdp"
        android:padding="@dimen/_16sdp">



        <View
            android:id="@+id/view2"
            android:layout_width="@dimen/_120sdp"
            android:layout_height="@dimen/_120sdp"
            android:layout_margin="@dimen/_16sdp"
            android:background="@drawable/logo_splash"
            android:alpha="0.10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />




        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/iv_logo_company"
            android:layout_width="@dimen/_50sdp"
            android:layout_height="@dimen/_50sdp"
            android:src="@drawable/backround_image"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:civ_border_color="@color/secondary"
            app:civ_border_width="@dimen/_2sdp" />


        <TextView
            android:id="@+id/tv_name_company"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="اسم الشركة"
            android:textColor="@color/secondary"
            android:layout_marginStart="@dimen/_8sdp"
            android:fontFamily="@font/somar_bold"
            android:textSize="@dimen/_21ssp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_logo_company"
            app:layout_constraintStart_toEndOf="@+id/iv_logo_company"
            app:layout_constraintTop_toTopOf="@+id/iv_logo_company" />


        <TextView
            android:id="@+id/tvNameCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/somar_bold"
            android:textAlignment="center"
            android:text="@string/details"
            android:layout_marginTop="@dimen/_4sdp"
            android:textColor="@color/secondary"
            android:textSize="@dimen/_19ssp"
            app:layout_constraintStart_toStartOf="@+id/iv_logo_company"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo_company" />


        <TextView
            android:id="@+id/tv_dic"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/somar_bold"
            android:textColor="@color/grey_bold"
            android:layout_marginTop="@dimen/_4sdp"
            android:textAlignment="viewStart"
            android:textSize="@dimen/_19ssp"
            android:text="fdfffdfd"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNameCategory" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_show"
            android:layout_width="0dp"
            android:layout_height="@dimen/_26sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/shape_bottom"
            android:fontFamily="@font/somar_bold"
            android:text="@string/show"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_14ssp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_dic" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>